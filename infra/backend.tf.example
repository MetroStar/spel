# =============================================================================
# Backend Configuration Example — S3 + DynamoDB Locking
# =============================================================================
# Copy this file to backend.tf and customize for your environment.
# DynamoDB locking used (instead of S3-native locking) for compatibility
# with both Terraform >= 1.0 and OpenTofu >= 1.0.
#
# PREREQUISITES:
#   1. Create the S3 bucket:
#      aws s3api create-bucket --bucket <BUCKET_NAME> --region <REGION> \
#        [--create-bucket-configuration LocationConstraint=<REGION>]
#
#   2. Enable versioning:
#      aws s3api put-bucket-versioning --bucket <BUCKET_NAME> \
#        --versioning-configuration Status=Enabled
#
#   3. Create the DynamoDB table:
#      aws dynamodb create-table \
#        --table-name <TABLE_NAME> \
#        --attribute-definitions AttributeName=LockID,AttributeType=S \
#        --key-schema AttributeName=LockID,KeyType=HASH \
#        --billing-mode PAY_PER_REQUEST \
#        --region <REGION>
#
# For GovCloud, consider setting:
#   export AWS_USE_FIPS_ENDPOINT=true
#
# CI pipelines initialize with -backend-config flags:
#   tofu init \
#     -backend-config="bucket=spel-ssm-opentofu-state" \
#     -backend-config="key=ci/opentofu.tfstate" \
#     -backend-config="region=us-gov-west-1" \
#     -backend-config="dynamodb_table=spel-ssm-opentofu-locks"
# =============================================================================

terraform {
  backend "s3" {
    # These values should be customized per environment.
    # They can also be provided via -backend-config flags during tofu init.

    bucket         = "REPLACE-WITH-YOUR-STATE-BUCKET"
    key            = "ssm-infra/opentofu.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "REPLACE-WITH-YOUR-LOCK-TABLE"

    # Uncomment for GovCloud:
    # region = "us-gov-west-1"
  }
}
